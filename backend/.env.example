# JWT Configuration (Required: minimum 256 bits / 32 characters long)
JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits-long-in-production

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/taskdb
DB_USERNAME=postgres
